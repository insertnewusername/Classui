{
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "styles.css", "dark.css"],
      "js": [
         "features/storage-utils.js",
         "features/assignment-stars.js",
         "features/classwork-completion-indicator.js",
         "features/clock.js",
         "features/core-timetable-sidebar-icons.js",
         "features/cursor-attraction.js",
         "features/decoration.js",
         "features/download-buttons.js",
         "features/floating-notes.js",
         "features/font-picker.js",
         "features/homebar-streamside.js",
         "features/settings-panel.js",
         "features/sidebar-controls.js",
         "features/sidebar-titles-banners.js",
         "features/storage-utils.js",
         "features/tutorial-content.js",
         "features/tutorial-modal.js",
         "features/hide-classroom-tools.js"
      ],
      "matches": [ "*://classroom.google.com/*" ]
   } ],
   "description": "GC Visuals – Enhanced Google Classroom with dark mode, strict 3‑zone colors, and liquid glass",
   "icons": {
      "128": "icon128.png",
      "48": "icon48.png"
   },
   "manifest_version": 3,
   "name": "GC Visuals",
   "permissions": [ "storage" ],
   "version": "1.0.0",
   "web_accessible_resources": [ {
      "matches": [ "*://classroom.google.com/*" ],
      "resources": [ "Icons/*", "Tutorial/*", "Decoration/*" ]
   } ]
}

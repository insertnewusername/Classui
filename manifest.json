{
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "styles.css", "dark.css", "color-pickers.css" ],
      "js": [ "Features/storage-utils.js", "Features/cloud-sync.js", "Features/download-buttons.js", "Features/core-timetable-sidebar-icons.js", "Features/decoration.js", "Features/sidebar-controls.js", "Features/settings-panel.js", "Features/sidebar-titles-banners.js", "Features/tutorial-modal.js", "Features/updates-popup.js", "Features/update-checker.js", "Features/homebar-streamside.js", "Features/classroom-search.js", "Features/clock.js", "Features/cursor-attraction.js", "Features/floating-notes.js", "Features/assignment-stars.js", "Features/font-picker.js", "content.js" ],
      "matches": [ "*://classroom.google.com/*" ]
   } ],
   "description": "Redefine Google Classroom with Dark mode, Search, Extensive customisation, and new intuitive features",
   "icons": {
      "128": "Images/Thumbs/icon128.png",
      "48": "Images/Thumbs/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "GC visuals",
   "permissions": [ "storage" ],
   "version": "3.16.4",
   "web_accessible_resources": [ {
      "matches": [ "*://classroom.google.com/*" ],
      "resources": [ "Icons/*", "Images/*", "Changelogs/*", "color-pickers.css" ]
   } ]
}
